AGENT_RUNTIME_APP_ENV=development
AGENT_RUNTIME_LOG_LEVEL=INFO
AGENT_RUNTIME_DATABASE_URL=postgresql+psycopg://agent_runtime:agent_runtime@postgres:5432/agent_runtime
AGENT_RUNTIME_TELEMETRY_BACKEND=local
AGENT_RUNTIME_TELEMETRY_LOCAL_PATH=/var/lib/agent-runtime/telemetry
AGENT_RUNTIME_TELEMETRY_MAX_REQUEST_BYTES=10485760
AGENT_RUNTIME_TELEMETRY_LATE_AFTER_SECONDS=300
AGENT_RUNTIME_DATABRICKS_ENABLED=false
AGENT_RUNTIME_DATABRICKS_HOST=
AGENT_RUNTIME_DATABRICKS_HTTP_PATH=
AGENT_RUNTIME_DATABRICKS_CATALOG=
AGENT_RUNTIME_DATABRICKS_SCHEMA=
NEXT_PUBLIC_API_URL=http://localhost:8000

